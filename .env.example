# .env.local 파일을 만들어 아래 키들을 채우세요 (.env.local은 git에 안 올라감).
# Vercel 배포 시에는 프로젝트 Settings → Environment Variables 에 같은 이름으로 추가.

# --- AI 학식 추천 (FactChat) ---
# 서버에서만 사용 (VITE_ 접두사 금지)
FACTCHAT_API_KEY=

# --- 토스페이먼츠 테스트 결제 ---
# 클라이언트 키: 공개용이라 브라우저 노출 OK → VITE_ 접두사 필수 (test_ck_...)
VITE_TOSS_CLIENT_KEY=
# 시크릿 키: 서버에서만! 절대 VITE_ 붙이지 말 것 (test_sk_...)
TOSS_SECRET_KEY=
